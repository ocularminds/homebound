# Copy to agentsafe/.env and set actual values from your Decionis workspace.
# This is a local development configuration, not a production deployment.
NODE_ENV=development
EXECUTOR_MODE=ENFORCEMENT
EXECUTOR_ESCALATION=MANAGED
EXECUTOR_POSTURE=DEVELOPMENT
EXECUTOR_ALLOW_PLAINTEXT_LISTENER=true
EXECUTOR_BIND_ADDRESS=127.0.0.1
PORT=8100
EXECUTOR_INTENT_TTL_SECONDS=290
EXECUTOR_JOURNAL_REQUIRED=true

# Required Decionis tenant identity and server-side credential.
EXECUTOR_TENANT_ID=
EXECUTOR_ACTOR_ID=homebound-bedrock-agent
EXECUTOR_ACTOR_TYPE=SERVICE
EXECUTOR_ACTOR_RUNTIME=homebound
EXECUTOR_CALLER_TOKEN=
DECIONIS_API_URL=https://api.decionis.com
DECIONIS_API_KEY=

# AgentSafe requires a trusted Presence approver in managed mode.
# Use the household parent's configured Decionis identity; do not pass this
# value from Bedrock or the MCP proposal.
PRESENCE_APPROVER_ID=
PRESENCE_APPROVER_ROLE=APPROVER
PRESENCE_VERIFICATION_LEVEL=HIGH_CONFIDENCE
PRESENCE_VERIFICATION_METHODS=WEBAUTHN,ACTIVE_LIVENESS

# Required by AgentSafe's configuration parser. Phase 2 registers no downstream
# action, so these values are not contacted or used as Ring credentials.
DOWNSTREAM_URL=https://ring-adapter.disabled.invalid/actions
DOWNSTREAM_SYSTEM=ring-simulator
DOWNSTREAM_OPERATION=governed-action
DOWNSTREAM_ENVIRONMENT=local
DOWNSTREAM_CREDENTIAL_HEADER=x-homebound-disabled
DOWNSTREAM_CREDENTIAL=phase-2-unused-no-provider-access
DOWNSTREAM_TIMEOUT_MS=1000

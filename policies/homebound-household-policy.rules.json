{
  "status": "VERSIONED_PROTOCOL_RULES_TEMPLATE",
  "version": "homebound-household-v1",
  "metadata": {
    "author": "HomeBound",
    "source": "HomeBound household policy",
    "home_context_contract": {
      "parent_roster_source": "Owner-managed parent email and role in HomeBound or Decionis workspace",
      "presence_role": "APPROVER",
      "identity_binding": "Decionis Accounts member identity mapped to Presence APPROVER; no email claim from the agent",
      "courier_recognition_source": "camera",
      "voice_confirmation": "household_confirmation",
      "timezone_source": "home configuration",
      "default_delivery_window_local": {
        "start": "14:00",
        "end": "18:00"
      },
      "owner_override": "publish a new org-scoped Decionis Protocol policy version"
    },
    "operational_notes": [
      "Courier time conditions use integer local_time_minutes because Decionis GT/GTE/LT/LTE comparisons are numeric.",
      "The deployment publisher merges these rules into the existing tenant bundle to preserve unrelated rules.",
      "MCP context fields are exact-bound proposal claims, not proof of camera, identity, delivery, or household-clock provenance."
    ]
  },
  "rules": [
    {
      "rule_id": "homebound.authenticated-parent-disarm-allow",
      "name": "Allow a direct parent disarm request only on a trusted identity claim",
      "decision_domain": "*",
      "when": {
        "all": [
          {
            "field": "context.agent_safe.action.type",
            "operator": "EQ",
            "value": "home.security.disarm"
          },
          {
            "field": "context.agent_safe.action.resource",
            "operator": "EQ",
            "value": "home_security"
          },
          {
            "field": "context.agent_safe.action.parameters.context_signals.authenticated_user_role",
            "operator": "EQ",
            "value": "parent"
          }
        ]
      },
      "then": {
        "action": "AUTO_APPROVE",
        "severity": "routine"
      },
      "priority": 450,
      "enabled": false,
      "rationale": "Mirrors the guide's parent-role override, but remains disabled until an authenticated identity provider supplies this claim independently of Bedrock/MCP arguments."
    },
    {
      "rule_id": "homebound.child-disarm-escalation",
      "name": "Require parent approval when a child requests a home security disarm",
      "decision_domain": "*",
      "when": {
        "all": [
          {
            "field": "context.agent_safe.action.type",
            "operator": "EQ",
            "value": "home.security.disarm"
          },
          {
            "field": "context.agent_safe.action.resource",
            "operator": "EQ",
            "value": "home_security"
          },
          {
            "field": "context.agent_safe.action.parameters.context_signals.user",
            "operator": "EQ",
            "value": "child"
          },
          {
            "field": "context.agent_safe.action.parameters.context_signals.location",
            "operator": "EQ",
            "value": "home"
          },
          {
            "field": "context.agent_safe.action.parameters.context_signals.device_group",
            "operator": "EQ",
            "value": "security_infrastructure"
          }
        ]
      },
      "then": {
        "action": "ESCALATE",
        "severity": "elevated",
        "authority": {
          "reason_codes": [
            "HUMAN_APPROVAL_REQUIRED"
          ],
          "selector": {
            "kind": "ROLE",
            "role_id": "APPROVER"
          },
          "verification_requirements": {
            "level": "HIGH_CONFIDENCE",
            "methods": [
              "WEBAUTHN",
              "ACTIVE_LIVENESS"
            ],
            "hardware_pki_required": false,
            "disallow_virtual_cameras": true
          },
          "resolution": {
            "quorum": 1,
            "delegation": "DISALLOWED",
            "fallback_role_ids": []
          },
          "expires_in_seconds": 60
        }
      },
      "priority": 400,
      "enabled": true,
      "rationale": "A child's request to disarm home security requires a parent to complete Decionis-managed Presence verification. No execution grant exists before Decionis reauthorizes the unchanged intent."
    },
    {
      "rule_id": "homebound.courier-unlock-in-window",
      "name": "Allow expected recognized courier at the side gate during the authorized window",
      "decision_domain": "*",
      "when": {
        "all": [
          {
            "field": "context.agent_safe.action.type",
            "operator": "EQ",
            "value": "home.entry.unlock"
          },
          {
            "field": "context.agent_safe.action.resource",
            "operator": "EQ",
            "value": "side_gate"
          },
          {
            "field": "context.agent_safe.action.parameters.context_signals.actor",
            "operator": "EQ",
            "value": "delivery-agent"
          },
          {
            "field": "context.agent_safe.action.parameters.context_signals.delivery_expected",
            "operator": "EQ",
            "value": true
          },
          {
            "field": "context.agent_safe.action.parameters.context_signals.courier_recognized",
            "operator": "EQ",
            "value": true
          },
          {
            "field": "context.agent_safe.action.parameters.context_signals.local_time_minutes",
            "operator": "GTE",
            "value": 840
          },
          {
            "field": "context.agent_safe.action.parameters.context_signals.local_time_minutes",
            "operator": "LTE",
            "value": 1080
          },
          {
            "field": "context.agent_safe.action.parameters.device_parameters.unlock_duration_seconds",
            "operator": "EQ",
            "value": 30
          },
          {
            "field": "context.agent_safe.action.parameters.context_signals.recognition_source",
            "operator": "EQ",
            "value": "camera"
          },
          {
            "field": "context.agent_safe.action.parameters.context_signals.household_confirmation",
            "operator": "EQ",
            "value": true
          }
        ]
      },
      "then": {
        "action": "AUTO_APPROVE",
        "severity": "routine"
      },
      "priority": 300,
      "enabled": true,
      "rationale": "Identity and delivery intent are insufficient on their own; this bounded unlock also requires a local-time value inside the configured household window."
    },
    {
      "rule_id": "homebound.courier-unlock-outside-window",
      "name": "Block an otherwise recognized courier outside the authorized window",
      "decision_domain": "*",
      "when": {
        "all": [
          {
            "field": "context.agent_safe.action.type",
            "operator": "EQ",
            "value": "home.entry.unlock"
          },
          {
            "field": "context.agent_safe.action.resource",
            "operator": "EQ",
            "value": "side_gate"
          },
          {
            "field": "context.agent_safe.action.parameters.context_signals.actor",
            "operator": "EQ",
            "value": "delivery-agent"
          },
          {
            "field": "context.agent_safe.action.parameters.context_signals.delivery_expected",
            "operator": "EQ",
            "value": true
          },
          {
            "field": "context.agent_safe.action.parameters.context_signals.courier_recognized",
            "operator": "EQ",
            "value": true
          },
          {
            "field": "context.agent_safe.action.parameters.context_signals.local_time_minutes",
            "operator": "GT",
            "value": 1080
          },
          {
            "field": "context.agent_safe.action.parameters.context_signals.recognition_source",
            "operator": "EQ",
            "value": "camera"
          },
          {
            "field": "context.agent_safe.action.parameters.context_signals.household_confirmation",
            "operator": "EQ",
            "value": true
          }
        ]
      },
      "then": {
        "action": "AUTO_REJECT",
        "severity": "urgent"
      },
      "priority": 350,
      "enabled": true,
      "rationale": "Block the side-gate unlock after 18:00 local household time, even when the courier is expected and recognized. The policy owner must confirm the tenant's stable reason-code mapping before publication."
    },
    {
      "rule_id": "homebound.courier-unlock-before-window",
      "name": "Block an otherwise recognized courier before the authorized window",
      "decision_domain": "*",
      "when": {
        "all": [
          {
            "field": "context.agent_safe.action.type",
            "operator": "EQ",
            "value": "home.entry.unlock"
          },
          {
            "field": "context.agent_safe.action.resource",
            "operator": "EQ",
            "value": "side_gate"
          },
          {
            "field": "context.agent_safe.action.parameters.context_signals.actor",
            "operator": "EQ",
            "value": "delivery-agent"
          },
          {
            "field": "context.agent_safe.action.parameters.context_signals.delivery_expected",
            "operator": "EQ",
            "value": true
          },
          {
            "field": "context.agent_safe.action.parameters.context_signals.courier_recognized",
            "operator": "EQ",
            "value": true
          },
          {
            "field": "context.agent_safe.action.parameters.context_signals.local_time_minutes",
            "operator": "LT",
            "value": 840
          },
          {
            "field": "context.agent_safe.action.parameters.context_signals.recognition_source",
            "operator": "EQ",
            "value": "camera"
          },
          {
            "field": "context.agent_safe.action.parameters.context_signals.household_confirmation",
            "operator": "EQ",
            "value": true
          }
        ]
      },
      "then": {
        "action": "AUTO_REJECT",
        "severity": "urgent"
      },
      "priority": 350,
      "enabled": true,
      "rationale": "Block the side-gate unlock before 14:00 local household time, even when the courier is expected and recognized."
    }
  ]
}

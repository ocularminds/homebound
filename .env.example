# The MCP service binds to loopback by default. Set a token before exposing it.
HOMEBOUND_MCP_HOST=127.0.0.1
HOMEBOUND_MCP_PORT=8000
HOMEBOUND_MCP_ENDPOINT=http://127.0.0.1:8000/mcp
HOMEBOUND_MCP_BEARER_TOKEN=
HOMEBOUND_MCP_ALLOWED_HOSTS=localhost:8000,127.0.0.1:8000,[::1]:8000
HOMEBOUND_MCP_ALLOWED_ORIGINS=

# Optional Phase 2/3 connection to the local official AgentSafe executor.
# Uncomment both after agentsafe/.env is configured; the token must match
# EXECUTOR_CALLER_TOKEN there.
# HOMEBOUND_AGENTSAFE_URL=http://127.0.0.1:8100
# HOMEBOUND_AGENTSAFE_BEARER_TOKEN=
# If AgentSafe is enabled, set both dossier values to match
# HOMEBOUND_DOSSIER_ARCHIVER_TOKEN in agentsafe/.env. This token can archive
# and verify dossiers; it cannot call the Ring simulator.
# HOMEBOUND_DOSSIER_ARCHIVER_URL=http://127.0.0.1:8101
# HOMEBOUND_DOSSIER_ARCHIVER_TOKEN=
HOMEBOUND_AUDIT_DIRECTORY=audit

# boto3 uses its standard credential chain (AWS profile, SSO, or environment).
AWS_REGION=us-east-1
BEDROCK_MODEL_ID=

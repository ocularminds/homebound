# The MCP service binds to loopback by default. Set a token before exposing it.
HOMEBOUND_MCP_HOST=127.0.0.1
HOMEBOUND_MCP_PORT=8000
HOMEBOUND_MCP_ENDPOINT=http://127.0.0.1:8000/mcp
HOMEBOUND_MCP_BEARER_TOKEN=
HOMEBOUND_MCP_ALLOWED_HOSTS=localhost:8000,127.0.0.1:8000,[::1]:8000
HOMEBOUND_MCP_ALLOWED_ORIGINS=

# Optional Phase 2/3 connection to the local official AgentSafe executor.
# Uncomment both after agentsafe/.env is configured; the token must match
# EXECUTOR_CALLER_TOKEN there.
# HOMEBOUND_AGENTSAFE_URL=http://127.0.0.1:8100
# HOMEBOUND_AGENTSAFE_BEARER_TOKEN=
# If AgentSafe is enabled, set both dossier values to match
# HOMEBOUND_DOSSIER_ARCHIVER_TOKEN in agentsafe/.env. This token can archive
# and verify dossiers; it cannot call the Ring simulator.
# HOMEBOUND_DOSSIER_ARCHIVER_URL=http://127.0.0.1:8101
# HOMEBOUND_DOSSIER_ARCHIVER_TOKEN=
HOMEBOUND_AUDIT_DIRECTORY=audit

# Created by scripts/publish_homebound_policy.py after the Protocol bundle is
# verified. This is local home/workspace association metadata, not a secret.
HOMEBOUND_POLICY_BINDING_PATH=.homebound/policy-binding.json

# boto3 uses its standard credential chain. Replace Decionis if your profile differs.
AWS_PROFILE=Decionis
AWS_REGION=us-east-1
BEDROCK_MODEL_ID=us.amazon.nova-lite-v1:0

# Local Alexa-style web simulator. This interface is loopback-only.
HOMEBOUND_WEB_HOST=127.0.0.1
HOMEBOUND_WEB_PORT=8300
HOMEBOUND_HOME_TIMEZONE=Europe/Stockholm

# Optional Deepgram voice. Keep the key server-side; never put it in browser code.
# If absent from the environment, read only DEEPGRAM_API_KEY from this file.
HOMEBOUND_VOICE_ENV_FILE=agentsafe/.env
# For a Secrets Manager key, resolve its reference with asm-exec when launching:
# DEEPGRAM_API_KEY='{{resolve:secretsmanager:YOUR_SECRET_ID:SecretString:api_key}}'
# asm-exec -- python -m app.cli.web --with-services
# An unresolved reference disables voice instead of being sent to Deepgram.
DEEPGRAM_API_KEY=
DEEPGRAM_STT_MODEL=nova-3
DEEPGRAM_TTS_MODEL=aura-2-thalia-en
